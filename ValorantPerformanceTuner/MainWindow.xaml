<Window x:Class="ValorantPerformanceTuner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ValorantPerformanceTuner.ViewModels"
        Title="Valorant Performance Tuner Pro"
        Width="1380"
        Height="900"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid Background="{StaticResource BgDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BgMid}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="450"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="20,0,0,0">
                    <TextBlock Text="VPT" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentRed}" VerticalAlignment="Center"/>
                    <TextBlock Text="Performance Tuner Pro" Margin="12,0,0,0" FontSize="24" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,18,0" VerticalAlignment="Center">
                    <Button Content="Auto Scan" Command="{Binding AutoScanCommand}" Background="{StaticResource AccentBlue}" Width="120" Height="46"/>
                    <Button Content="Optimize Valorant" Command="{Binding OptimizeCommand}" Background="{StaticResource AccentRed}" Width="170" Height="46"/>
                    <Button Content="Restore Defaults" Command="{Binding RestoreDefaultsCommand}" Width="150" Height="46"/>
                    <Button Content="Export Report" Command="{Binding ExportReportCommand}" Width="140" Height="46"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BgMid}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                <StackPanel Margin="20">
                    <TextBlock Text="Modules" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <Button Content="Network Analyzer" Height="46" Background="{StaticResource PanelAlt}" Margin="0,6" />
                    <Button Content="FPS Optimizer" Height="46" Background="{StaticResource PanelAlt}" Margin="0,6" />
                    <Button Content="NVIDIA Optimizer" Height="46" Background="{StaticResource PanelAlt}" Margin="0,6" />
                    <Button Content="Windows Optimizer" Height="46" Background="{StaticResource PanelAlt}" Margin="0,6" />
                    <Button Content="Memory Analyzer" Height="46" Background="{StaticResource PanelAlt}" Margin="0,6" />
                    <Button Content="Startup Analyzer" Height="46" Background="{StaticResource PanelAlt}" Margin="0,6" />
                    <Button Content="Registry Backup Center" Height="46" Background="{StaticResource PanelAlt}" Margin="0,6" />
                    <Button Content="Advanced Tweaks Center" Height="46" Background="{StaticResource PanelAlt}" Margin="0,6" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="170"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="260"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="8" Background="{StaticResource Panel}" CornerRadius="16" BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <StackPanel Margin="18">
                            <TextBlock Text="CPU" Foreground="{StaticResource TextSecondary}" FontSize="14"/>
                            <TextBlock Text="{Binding Hardware.CpuUsage, StringFormat={}{0:F0}%}" FontSize="34" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Hardware.CpuName}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="8" Background="{StaticResource Panel}" CornerRadius="16" BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <StackPanel Margin="18">
                            <TextBlock Text="GPU" Foreground="{StaticResource TextSecondary}" FontSize="14"/>
                            <TextBlock Text="{Binding Hardware.GpuUsage, StringFormat={}{0:F0}%}" FontSize="34" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Hardware.GpuName}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Margin="8" Background="{StaticResource Panel}" CornerRadius="16" BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <StackPanel Margin="18">
                            <TextBlock Text="RAM" Foreground="{StaticResource TextSecondary}" FontSize="14"/>
                            <TextBlock Text="{Binding Hardware.RamUsage, StringFormat={}{0:F0}%}" FontSize="34" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Hardware.RamInfo}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Margin="8" Background="{StaticResource Panel}" CornerRadius="16" BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <StackPanel Margin="18">
                            <TextBlock Text="Performance Score" Foreground="{StaticResource TextSecondary}" FontSize="14"/>
                            <TextBlock Text="{Binding Score}" FontSize="34" FontWeight="Bold"/>
                            <TextBlock Text="{Binding FpsText}" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="8" Background="{StaticResource Panel}" CornerRadius="16" BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="System Health" FontSize="24" FontWeight="SemiBold"/>
                            <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Hardware.WindowsVersion}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Hardware.CpuName}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Hardware.GpuName}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Hardware.PowerPlan}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Hardware.HealthSummary}" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Hardware.LastScanTime}" Margin="0,0,0,8"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Margin="8" Background="{StaticResource Panel}" CornerRadius="16" BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Network" FontSize="24" FontWeight="SemiBold"/>
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="{Binding NetworkText}" Margin="0,8,0,6"/>
                                <TextBlock Text="{Binding Network.AdapterName}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Network.IpV4}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Network.PingMs, StringFormat={}{0:F0} ms}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Network.JitterMs, StringFormat={}{0:F0} ms}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Network.PacketLossPercent, StringFormat={}{0:F1}%}" Margin="0,0,0,4"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Margin="8" Background="{StaticResource Panel}" CornerRadius="16" BorderBrush="{StaticResource Border}" BorderThickness="1">
                    <Grid Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Optimization Recommendations" FontSize="24" FontWeight="SemiBold"/>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Recommendations}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="0,12,0,0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="2" Padding="10" CornerRadius="10" Background="#1C2940" BorderBrush="{StaticResource Border}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Why}" Foreground="{StaticResource AccentGold}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Evidence}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
