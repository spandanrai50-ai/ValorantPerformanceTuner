<Window x:Class="ValorantTuner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Valorant Tuner" Height="800" Width="1240" MinHeight="620" MinWidth="960"
        Background="#0A0F17" Foreground="#ECF2FA" FontFamily="Segoe UI"
        Loaded="Window_Loaded">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource Edge}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="18" />
    </Style>
    <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="MinWidth" Value="140" />
      <Setter Property="Margin" Value="0,0,12,12" />
    </Style>
  </Window.Resources>

  <Grid Margin="28,22,28,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="VALORANT TUNER" FontSize="28" FontWeight="Black" Foreground="{StaticResource Accent}" />
        <TextBlock Text="Safe performance readiness scan for Windows — read-only by default" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" />
      </StackPanel>
      <Border Grid.Column="1" Background="#18243A" CornerRadius="12" Padding="12,6" VerticalAlignment="Top">
        <TextBlock Text="NO GAME PROCESS MODIFICATION" Foreground="#BBD2FF" FontSize="11" FontWeight="Bold" />
      </Border>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,22,0,10">
      <Button x:Name="ScanButton" Background="{StaticResource Accent}" Click="ScanButton_Click" Content="Run Safe Scan" ToolTip="Reads system and game readiness information without changing settings." />
      <Button x:Name="ExportButton" Click="ExportButton_Click" Content="Export Report" ToolTip="Saves this scan as an HTML report in Documents." />
      <Button Click="NvidiaButton_Click" Content="Open NVIDIA App" ToolTip="Opens NVIDIA App if it is installed." />
      <Button Click="ConfigButton_Click" Content="Open VALORANT Config" ToolTip="Opens the local VALORANT configuration folder if it exists." />
    </StackPanel>

    <WrapPanel Grid.Row="2" Margin="0,6,0,8">
      <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="CPU" Foreground="{StaticResource TextMuted}" FontSize="11" /><TextBlock x:Name="CpuValue" Text="Scanning…" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="220" /></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="NVIDIA GPU" Foreground="{StaticResource TextMuted}" FontSize="11" /><TextBlock x:Name="GpuValue" Text="Scanning…" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="220" /></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="GPU TEMP" Foreground="{StaticResource TextMuted}" FontSize="11" /><TextBlock x:Name="GpuTempValue" Text="—" FontSize="21" FontWeight="Bold" /></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="AVAILABLE RAM" Foreground="{StaticResource TextMuted}" FontSize="11" /><TextBlock x:Name="MemoryValue" Text="Scanning…" FontSize="21" FontWeight="Bold" /></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="READINESS SCORE" Foreground="{StaticResource TextMuted}" FontSize="11" /><TextBlock x:Name="ScoreValue" Text="—" FontSize="21" FontWeight="Bold" Foreground="#79AEFF" /></StackPanel></Border>
    </WrapPanel>

    <Grid Grid.Row="3" Margin="0,10,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Margin="0,0,14,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="SCAN FINDINGS" FontSize="17" FontWeight="Bold" />
            <TextBlock Text="Every result includes its source so you can make the call." Foreground="{StaticResource TextMuted}" FontSize="12" />
          </StackPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="FindingList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{Binding SeverityColor}" BorderThickness="4,0,0,0" Background="#131C29" CornerRadius="5" Padding="14,10" Margin="0,0,0,9">
                    <StackPanel>
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Detail}" Foreground="#D4E0EF" Margin="0,4,0,0" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Evidence}" Foreground="{StaticResource TextMuted}" FontFamily="Cascadia Mono" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <StackPanel Grid.Column="1">
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="WHAT THIS APP DOES" FontSize="15" FontWeight="Bold" />
            <TextBlock Text="• Checks Windows readiness, VALORANT status, GPU telemetry and input settings&#x0a;• Uses NVIDIA's nvidia-smi only when it is installed&#x0a;• Does not inject, hook, scan or modify the game process&#x0a;• Does not change system settings automatically" Foreground="{StaticResource TextMuted}" Margin="0,10,0,0" LineHeight="20" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="NEXT STEP" FontSize="15" FontWeight="Bold" />
            <TextBlock x:Name="NextStepText" Text="Run a scan to see focused, evidence-backed suggestions." Foreground="{StaticResource TextMuted}" Margin="0,10,0,0" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="4">
      <ProgressBar x:Name="BusyBar" Height="3" IsIndeterminate="True" Visibility="Collapsed" Background="Transparent" Foreground="{StaticResource Accent}" BorderThickness="0" />
      <TextBlock x:Name="StatusText" Text="Ready. Nothing has been changed." Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</Window>

